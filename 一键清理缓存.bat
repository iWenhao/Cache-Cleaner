@echo off
setlocal
chcp 65001 >nul 2>&1
set "CLEANCACHE_SRC=%~f0"
set "CC_PAUSE=1"
for %%a in (%*) do if /i "%%a"=="-NoPause" set "CC_PAUSE=0"
REM ============================================================
REM  Cache cleaner - single file, no companion file needed.
REM  The PowerShell engine is stored at the bottom of this file
REM  as base64 so that this file stays 100% ASCII. A UTF-8 batch
REM  file containing Chinese text can make cmd misparse or abort
REM  its own contents. Do not remove the "#B64#" lines below.
REM
REM  Usage: double-click to run. Optional switches:
REM    -DryRun   -Yes   -IncludeAdmin   -MinAgeDays N   -NoPause
REM    example:  CacheCleaner.bat -DryRun
REM ============================================================

where powershell >nul 2>&1
if errorlevel 1 (
    echo [ERROR] PowerShell is not available on this computer.
    echo.
    pause
    exit /b 1
)

powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -Command "$c = @(Get-Content -LiteralPath $env:CLEANCACHE_SRC -Encoding UTF8 | Where-Object { $_.StartsWith('REM #B64#') } | ForEach-Object { $_.Substring(9) }); if ($c.Count -lt 1) { Write-Host '[ERROR] payload missing'; exit 9 }; & ([scriptblock]::Create([System.Text.Encoding]::UTF8.GetString([System.Convert]::FromBase64String(($c -join ''))))) %*"
set "EC=%ERRORLEVEL%"

if not "%EC%"=="0" (
    echo.
    echo [ERROR] The script stopped with exit code %EC%.
    echo.
)
if "%CC_PAUSE%"=="1" pause
endlocal

