@echo off
setlocal
chcp 65001 >nul 2>&1
REM ============================================================
REM  Cache cleaner - single file, no companion file needed.
REM
REM  GENERATED FILE - DO NOT EDIT THE "#B64#" BLOCK BY HAND.
REM    source of truth : src/cleaner.ps1
REM    rebuild         : powershell -NoProfile -ExecutionPolicy Bypass -File build.ps1
REM
REM  The PowerShell body is stored as base64 so that this file stays
REM  100% ASCII. A UTF-8 batch file containing Chinese text can make
REM  cmd misparse or abort its own contents.
REM
REM  Usage: double-click to run. Optional switches (no spaces inside an
REM  argument, they are split on whitespace):
REM    -DryRun  -Yes  -IncludeAdmin  -MinAgeDays N  -NoPause  -Report
REM    -NoArrow (remove the shortcut overlay arrow, needs admin)
REM    -RestoreArrow (put it back)
REM ============================================================

set "CLEANCACHE_SRC=%~f0"
set "CC_ARGS=%*"
set "CC_PAUSE=1"
REM Substring test via echo|findstr, NOT "%CC_ARGS:-NoPause=%".
REM When %* is empty CC_ARGS is empty, and %EMPTY%:-NoPause=% expands to
REM "-NoPause" itself (the literal after :-), so the old comparison became
REM "" == "-NoPause", the "not" flipped, and CC_PAUSE was set to 0 even with
REM no switch at all -> the line below jumped straight to cc_end and never
REM held the window. Measured on this machine: empty args gave CC_PAUSE=0,
REM -DryRun gave 1. Fixed values now: empty=1, -DryRun=1, -NoPause=0,
REM "-Yes -DryRun -NoPause"=0, "-Yes -DryRun"=1.
echo %CC_ARGS%| findstr /c:"-NoPause" >nul
if not errorlevel 1 set "CC_PAUSE=0"

where powershell >nul 2>&1
if errorlevel 1 (
    where pwsh >nul 2>&1
    if errorlevel 1 (
        echo [ERROR] PowerShell is not available on this computer.
        echo.
        if "%CC_PAUSE%"=="1" pause
        exit /b 1
    )
    set "CC_PS=pwsh"
) else (
    set "CC_PS=powershell"
)

"%CC_PS%" -NoLogo -NoProfile -ExecutionPolicy Bypass -Command "$c = @(Get-Content -LiteralPath $env:CLEANCACHE_SRC -Encoding UTF8 | Where-Object { $_.StartsWith('REM #B64#') } | ForEach-Object { $_.Substring(9) }); if ($c.Count -lt 1) { Write-Host '[ERROR] payload missing'; exit 9 }; $b = ($c -join ''); if (($b.Length -band 3) -ne 0) { Write-Host '[ERROR] payload truncated'; exit 8 }; $src = ''; try { $src = [System.Text.Encoding]::UTF8.GetString([System.Convert]::FromBase64String($b)) } catch { Write-Host '[ERROR] payload corrupt'; exit 8 }; $av = @(); $raw = [Environment]::GetEnvironmentVariable('CC_ARGS'); if ($raw -and $raw.Trim()) { $av = @($raw -split '\s+') }; & ([System.Management.Automation.ScriptBlock]::Create($src)) @av"
set "EC=%ERRORLEVEL%"

if not "%EC%"=="0" (
    echo.
    echo [ERROR] The script stopped with exit code %EC%.
    echo.
)
if "%CC_PAUSE%"=="0" goto cc_end
REM Hold the window so the summary stays readable, with a hold no keystroke can
REM release.  Measured on this machine, in a real double-click-style console:
REM   pause                      -> released by a leftover Enter in the input buffer
REM   timeout /t 3               -> waits 3s correctly
REM   timeout /t -1              -> waits until ANY key, so the same leftover Enter
REM                                  closes the window the instant the summary prints
REM   timeout /t -1 /nobreak     -> returns at once with errorlevel 0 (useless)
REM Only an idle wait holds, so ask PowerShell to sleep until the window is closed
REM (Ctrl+C ends it, X closes it).  With redirected input the call returns right
REM away, which is what piped and scheduled runs need.
"%CC_PS%" -NoLogo -NoProfile -ExecutionPolicy Bypass -Command "if (-not [Console]::IsInputRedirected) { while ($true) { Start-Sleep -Seconds 3600 } }"
:cc_end
endlocal
